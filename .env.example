# Cotana environment template
# Vercel note:
# Use the same key names below in Vercel for Development, Preview, and Production.
# Vercel does not need separate variable names for dev/live. You assign different values per environment.

# -----------------------------------------------------------------------------
# Vercel production paste block
# Add these in Vercel > cotana > Settings > Environment Variables > Production.
# Keep values blank here. Paste real values only in Vercel or .env.local.
# -----------------------------------------------------------------------------

# Required for cotana.xyz to boot
# DATABASE_URL: pooled Postgres connection string, usually Neon pooled URL.
# DIRECT_URL: direct Postgres connection string for Prisma migrations.
# REDIS_URL: Upstash Redis URL.
# COTANA_SESSION_SECRET: long random string for signed sessions.
# ADMIN_ALLOWLIST_EMAIL: admin email allowed into the admin app.
DATABASE_URL=""
DIRECT_URL=""
REDIS_URL=""
COTANA_SESSION_SECRET=""
ADMIN_ALLOWLIST_EMAIL=""

# Required for public URLs and registry links
NEXT_PUBLIC_STORE_URL="https://cotana.xyz"
NEXT_PUBLIC_ADMIN_URL="https://cotana-admin.vercel.app"
NEXT_PUBLIC_REGISTRY_URL="https://cotana.xyz/.well-known/cotana-agent-registry"

# Required for sign-in
# From Privy app settings.
NEXT_PUBLIC_PRIVY_APP_ID=""
NEXT_PUBLIC_PRIVY_CLIENT_ID=""
PRIVY_APP_ID=""
PRIVY_APP_SECRET=""
PRIVY_VERIFICATION_KEY=""
# NEXT_PUBLIC_PRIVY_CLIENT_ID is optional unless a Privy app client is configured.
# PRIVY_VERIFICATION_KEY is optional; the server SDK can resolve signing keys with PRIVY_APP_SECRET.

# Required for production jobs
# From Inngest production environment signing/event keys.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Required for production semantic search.
# On Vercel, AI Gateway can use automatic OIDC if the project has AI Gateway enabled.
# For local development or non-Vercel environments, paste AI_GATEWAY_API_KEY.
AI_GATEWAY_API_KEY=""
AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"
AI_GATEWAY_EMBEDDING_MODEL="openai/text-embedding-3-small"

# Legacy fallback only. Prefer AI Gateway for Cotana.
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Optional production analytics
POSTHOG_KEY=""
POSTHOG_HOST="https://app.posthog.com"
COTANA_ENABLE_ANALYTICS="false"

# Optional production signal providers
DEFILLAMA_API_KEY=""
COVALENT_API_KEY=""
COVALENT_BASE_URL="https://api.covalenthq.com/v1"
COVALENT_TIMEOUT_MS="10000"
COTANA_ENABLE_SIGNAL_PROVIDERS="false"

# Production safety flags
COTANA_SEED_LAUNCH_CATALOG="false"
COTANA_SEED_WEAK_AGENT_FIXTURES="false"
COTANA_STAGING_SEED_CONFIRM="false"
COTANA_STAGING_SEED_LOADED="false"
COTANA_CATALOG_COVERAGE_ACCEPTED="false"
COTANA_REGISTRY_COVERAGE_ACCEPTED="false"
COTANA_SMOKE_TESTS_PASSING="false"
COTANA_E2E_TESTS_PASSING="false"
COTANA_MIGRATION_STATUS_CHECKED="false"
COTANA_PRODUCTION_SEED_GUARD_ACTIVE="false"
COTANA_DOCS_UPDATED="false"
COTANA_KNOWN_WARNINGS_ACKNOWLEDGED="false"
COTANA_CONFIRM_PRODUCTION_IMPORT="false"

# -----------------------------------------------------------------------------
# Local development paste block
# Use this in .env.local when running Cotana on your machine.
# -----------------------------------------------------------------------------

# NODE_ENV="development"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cotana"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cotana"
# REDIS_URL="redis://localhost:6379"
# COTANA_SESSION_SECRET="replace-with-a-long-random-string"
# ADMIN_ALLOWLIST_EMAIL="admin@cotana.app"
# NEXT_PUBLIC_STORE_URL="http://localhost:3000"
# NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
# NEXT_PUBLIC_REGISTRY_URL="http://localhost:3000/.well-known/cotana-agent-registry"

# -----------------------------------------------------------------------------
# Core runtime
# Required in all environments
# -----------------------------------------------------------------------------
NODE_ENV="development"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cotana"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cotana"
# REDIS_URL="redis://localhost:6379"
# COTANA_SESSION_SECRET="replace-with-a-long-random-string"
# ADMIN_ALLOWLIST_EMAIL="admin@cotana.app"
# COTANA_SEED_LAUNCH_CATALOG="false"
# COTANA_SEED_WEAK_AGENT_FIXTURES="false"

# -----------------------------------------------------------------------------
# Public app URLs
# Required in production
# Development example values are below
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_STORE_URL="http://localhost:3000"
# NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
# NEXT_PUBLIC_REGISTRY_URL="http://localhost:3000/.well-known/cotana-agent-registry"

# Production examples for Vercel:
# NEXT_PUBLIC_STORE_URL="https://cotana.xyz"
# NEXT_PUBLIC_ADMIN_URL="https://cotana-admin.vercel.app"
# NEXT_PUBLIC_REGISTRY_URL="https://cotana.xyz/.well-known/cotana-agent-registry"

# -----------------------------------------------------------------------------
# Privy
# Required for auth
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_PRIVY_APP_ID=""
# NEXT_PUBLIC_PRIVY_CLIENT_ID=""
# PRIVY_APP_ID=""
# PRIVY_APP_SECRET=""
# PRIVY_VERIFICATION_KEY=""
# NEXT_PUBLIC_PRIVY_CLIENT_ID is optional unless a Privy app client is configured.
# PRIVY_VERIFICATION_KEY is optional; the server SDK can resolve signing keys with PRIVY_APP_SECRET.

