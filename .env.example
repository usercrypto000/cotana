# COTANA_ENABLE_ANALYTICS="false"

# -----------------------------------------------------------------------------
# Inngest
# Required if background jobs/webhooks are enabled
# -----------------------------------------------------------------------------
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""

# -----------------------------------------------------------------------------
# Embeddings / semantic search
# Preferred code path: Vercel AI Gateway.
# -----------------------------------------------------------------------------
# AI_GATEWAY_API_KEY=""
# AI_GATEWAY_BASE_URL="https://ai-gateway.vercel.sh/v1"
# AI_GATEWAY_EMBEDDING_MODEL="openai/text-embedding-3-small"
# OPENAI_API_KEY=""
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# -----------------------------------------------------------------------------
# Signal providers
# Current code path: DeFiLlama plus Covalent/GoldRush readiness.
# Covalent app-level signals require app metadata such as contract addresses or
# protocol identifiers before the provider can produce reliable catalog metrics.
# -----------------------------------------------------------------------------
# DEFILLAMA_API_KEY=""
# COTANA_ENABLE_SIGNAL_PROVIDERS="false"

# Picked Covalent APIs for Cotana:
# - DeFi Positions: lending / yield positions and protocol exposure
# - Activity: swap, transfer, and approval activity for engagement signals
# - Transactions: fallback transaction history and volume-style heuristics
# - Token Info: token metadata and pricing enrichment where needed
#
# Not picked right now:
# - Balances: not needed for app discovery
# - Collectibles: not needed for current categories
# - Token Holders: useful later, not required for current ranking loop
# - SVM endpoints: optional later if Cotana expands Solana-specific intelligence
# COVALENT_API_KEY=""
# COVALENT_BASE_URL="https://api.covalenthq.com/v1"
# COVALENT_TIMEOUT_MS="10000"
# COTANA_STAGING_SEED_CONFIRM="false"

# -----------------------------------------------------------------------------
# Production readiness checklist acknowledgements
# Used by the admin launch checklist. Set these only after the matching checks
# have passed for the target environment.
# -----------------------------------------------------------------------------
# COTANA_STAGING_SEED_LOADED="false"
# COTANA_CATALOG_COVERAGE_ACCEPTED="false"
# COTANA_REGISTRY_COVERAGE_ACCEPTED="false"
# COTANA_SMOKE_TESTS_PASSING="false"
# COTANA_E2E_TESTS_PASSING="false"
# COTANA_MIGRATION_STATUS_CHECKED="false"
# COTANA_PRODUCTION_SEED_GUARD_ACTIVE="false"
# COTANA_DOCS_UPDATED="false"
# COTANA_KNOWN_WARNINGS_ACKNOWLEDGED="false"
# COTANA_CONFIRM_PRODUCTION_IMPORT="false"
